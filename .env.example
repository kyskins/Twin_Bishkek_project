# DNS A/AAAA records for this domain must point to the VPS.
TWINGIS_DOMAIN=your-domain.example

# Optional. Add the public website origin to the key's allowed origins in 2GIS.
TWINGIS_MAPGL_KEY=

# Set these to the deploy user's numeric IDs on the VPS (`id -u`, `id -g`).
TWINGIS_UID=1000
TWINGIS_GID=1000
